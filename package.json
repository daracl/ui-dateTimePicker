{
  "name": "@daracl/datetimepicker",
  "version": "0.0.14",
  "sideEffects": [
    "./style/*.scss",
    "./style/*.css",
    "./dist/*.css",
    "./dist/*.js",
    "./dist/*.cjs",
    "./src/global.ts",
    "./src/index.umd.ts"
  ],
  "description": "Dacacl Datetime picker",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/dateTimePicker",
    "daracl-dateTimePicker",
    "daracl.dateTimePicker",
    "dateTimePicker",
    "picker",
    "daracl",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/daracl/ui-dateTimePicker",
  "bugs": {
    "url": "https://github.com/daracl/ui-dateTimePicker/issues",
    "email": "darainfosys@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-dateTimePicker.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.datetimepicker.umd.js"
    },
    "./dist/*": "./dist/*",
    "./style/*": "./style/*"
  },
  "files": [
    "dist",
    "style"
  ],
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "dependencies": {
    "@daracl/ui-style": "^0.0.8"
  },
  "devDependencies": {
    "@daracl/core": "^0.0.12",
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.1.0",
    "material-icons": "^1.13.8",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.106.1",
    "typedoc": "^0.28.13",
    "typescript": "5.6.3",
    "vite": "~7.3.7"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build.mjs",
    "build:umd": "vite build --config vite.config.umd.mjs --mode production && vite build --config vite.config.umd.mjs --mode development",
    "build:escjs": "vite build --config vite.config.mjs --mode production && vite build --config vite.config.mjs --mode development",
    "mergenclean": "npm run copy-dts && npm run build:tsc && npm run copy-unmin && npm run clean:unmin && npm run copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npm run build:tsc",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:types && npm run test:package",
    "pwtest": "playwright test",
    "clean:unmin": "node scripts/build-files.mjs clean-unmin",
    "copy-html": "node scripts/build-files.mjs html",
    "copy-unmin": "node scripts/build-files.mjs unmin",
    "copy-dts": "node scripts/build-files.mjs dts",
    "audit:security": "npm audit --omit=dev",
    "audit:security:all": "npm audit",
    "test:package": "node scripts/package-smoke.mjs",
    "test:types": "tsc --noEmit --strict --module ESNext --moduleResolution Bundler --target ES2020 --lib ES2020,DOM tests/types.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@daracl/core": "^0.0.12"
  },
  "type": "module"
}
